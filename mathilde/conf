server {
    listen 8080;
    root /home/mlaussel/webserv/mathilde/server_files;
    error_page 404 /html/404.html;
    error_page 403 /html/403.html;
    error_page 500 /html/500.html;
    client_max_body_size 1000000;

    location /tmp/upload {
        methods GET POST DELETE;
        index html/index.html;
        autoindex on;
        upload_dir /home/mlaussel/webserv/mathilde/server_files/tmp;
    }

    location / {
        methods GET POST ;
        index html/index.html;
        autoindex on;
        upload_dir /home/mlaussel/webserv/mathilde/server_files/tmp;
    }

    location /secret {
    methods GET;
    autoindex off;
    }

    location /test {
        methods GET;
        autoindex on;
    }

}
