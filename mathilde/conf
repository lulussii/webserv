server {
    listen 8080;
    root /home/mlaussel/webserv/mathilde/server_files/html;
    error_page 404 /404.html;
    error_page 403 /403.html;
    error_page 500 /500.html;
    client_max_body_size 1000000;

    location /upload {
        methods GET POST DELETE;
        index index.html;
        autoindex on;
        upload_dir /home/mlaussel/webserv/mathilde/server_files/tmp;
    }

    location / {
        methods GET POST ;
        index index.html;
        autoindex on;
        upload_dir /home/mlaussel/webserv/mathilde/server_files/tmp;
    }

    location /secret {
    methods GET;
    autoindex off;
}

}
