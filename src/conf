server {
    listen 8080;
    root /home/lulussi/42/webserv2/src/server_files/html;
    error_page 404 /404.html;
    error_page 403 /403.html;
    error_page 500 /500.html;
    client_max_body_size 10000;

    location /upload {
        allow_methods POST GET DELETE;
        index index.html;
        autoindex on;
        upload_store /Users/mathildelaussel/webserv/mathilde/server_files/tmp/uploads;
    }

    location / {
        allow_methods POST GET DELETE;
        index index.html;
        autoindex on;
        upload_store /Users/mathildelaussel/webserv/mathilde/server_files/tmp/uploads;
    }
}
