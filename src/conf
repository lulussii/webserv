server {
    listen 8080;
    root /Users/mathildelaussel/webserv/mathilde/server_files/html;
    error_page 404 /404.html;
    error_page 403 /403.html;
    error_page 500 /50x.html;
    client_max_body_size 1000000;

    location /upload {
        methods POST GET DELETE;
        index index.html;
        autoindex on;
        upload_dir /Users/mathildelaussel/webserv/mathilde/server_files/tmp/uploads;
    }

    location / {
        methods POST GET DELETE;
        index index.html;
        autoindex on;
        upload_dir /Users/mathildelaussel/webserv/mathilde/server_files/tmp/uploads;
    }
}
